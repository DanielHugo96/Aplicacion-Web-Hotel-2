# Aplicacion-Web-Hotel-2 — plantilla de entorno
#
# Solo NOMBRES y defaults no sensibles (norma de planes, seccion 6.10).
# Nunca copiar valores reales aqui: `.env` es el archivo local y Git lo ignora.
# El catalogo de nombres y defaults es docs/especificacion/infraestructura/configuracion.md
# (secciones "Comunes a todos los servicios" y "Por servicio").
# Las credenciales (contrasenas, claves) se generan al ejecutar y quedan vacias en esta plantilla.

# ---------------------------------------------------------------------------
# Comunes a todos los servicios
# ---------------------------------------------------------------------------
# Perfil activo; los seeds solo corren en dev/demo, nunca en produccion.
SPRING_PROFILES_ACTIVE=dev

# Base de datos propia de cada servicio (nunca acceso cruzado).
# <db> = identity_db, hotel_db, reception_db, inventory_db, sales_db, reporting_db, notification_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/<db>
# <servicio> = identity, hotel, reception, inventory, sales, reporting, notification
SPRING_DATASOURCE_USERNAME=<servicio>_app
# Obligatoria; fuera de Git.
SPRING_DATASOURCE_PASSWORD=

# Registro Eureka y sus credenciales propias (distintas de las de usuario del hotel).
EUREKA_URL=http://localhost:8761/eureka
EUREKA_USERNAME=
EUREKA_PASSWORD=

# Solo si el servicio usa Kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Solo si el servicio usa Rabbit. <servicio> = usuario de broker con permisos por vhost.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=<servicio>
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/hotel-demo

# Validacion local del JWT (issuer y JWKS explicito, sin descubrimiento OIDC).
JWT_ISSUER=hotel-identity
JWK_SET_URI=http://identity-service/.well-known/jwks.json

# Token maquina; solo servicios que llaman a /internal/**.
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=

# Feign y circuit breaker.
FEIGN_CONNECT_TIMEOUT_MS=2000
FEIGN_READ_TIMEOUT_MS=5000
CB_WINDOW_SIZE=10
CB_FAILURE_RATE=50
CB_MIN_CALLS=5
CB_OPEN_MS=10000
CB_HALF_OPEN_CALLS=3

# Outbox e inbox.
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_ALERT_ATTEMPTS=10
OUTBOX_ALERT_PENDING_MINUTES=15
INBOX_RETENTION_DAYS=30

# Semilla de usuarios de demo (perfiles dev/demo); sin ella no se siembran credenciales.
DEMO_PASSWORD=

# Nivel de log; los logs estructurados llevan service, correlationId y eventId/commandId.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# api-gateway
# ---------------------------------------------------------------------------
RATE_LIMIT_PUBLIC_RPM=60
ROUTE_CONNECT_TIMEOUT_MS=2000
ROUTE_READ_TIMEOUT_MS=5000
GATEWAY_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# identity-service
# ---------------------------------------------------------------------------
# Clave privada RS256 fuera de Git (ruta al archivo, no la clave).
IDENTITY_SIGNING_KEY_FILE=
IDENTITY_JWK_KID=v1
TOKEN_TTL_MINUTES=15
MACHINE_TOKEN_TTL_MINUTES=5
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTRO_RATE_LIMIT_PER_MINUTE=3
ANONIMIZAR_INACTIVOS_ANIOS=5

# ---------------------------------------------------------------------------
# hotel-service
# ---------------------------------------------------------------------------
PUBLIC_CACHE_MAX_AGE_SECONDS=60
IMAGE_URL_ALLOWLIST=/assets/,https://

# ---------------------------------------------------------------------------
# reception-service
# ---------------------------------------------------------------------------
CLOSURE_RECOVERY_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# sales-service
# ---------------------------------------------------------------------------
SALE_RECOVERY_INTERVAL_MS=30000
SALE_PENDING_REJECT_AGE_SECONDS=120
SALE_MAX_LINEAS=50

# ---------------------------------------------------------------------------
# inventory-service
# ---------------------------------------------------------------------------
STOCK_BAJO_LIMITE=5

# ---------------------------------------------------------------------------
# reporting-service
# ---------------------------------------------------------------------------
REPORT_MAX_RANGE_DAYS=366
REPORTING_DEGRADED_TIMEOUT_MINUTES=5

# ---------------------------------------------------------------------------
# notification-service
# ---------------------------------------------------------------------------
# Mailpit en dev.
SMTP_HOST=localhost
SMTP_PORT=1025
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETENTION_SENT_DAYS=30
NOTIFICATION_AUDIT_RETENTION_DAYS=90
# `hotel.notification.admin` no es variable de entorno: se activa con la CLI
# local auditada del operador (flag --admin), asi que no tiene linea propia aqui.

# ---------------------------------------------------------------------------
# discovery-server
# ---------------------------------------------------------------------------
# Sin variables propias: publica su proceso y no depende de base de datos.

# ---------------------------------------------------------------------------
# infra (plan `infra-compose`): contenedores de infraestructura en Compose
# ---------------------------------------------------------------------------
# El compose los consume con `docker compose -f infra/compose.yaml --env-file .env`.
# Son credenciales: la plantilla solo publica los nombres, los valores van en `.env`.
# Genera valores aleatorios (p. ej. `openssl rand -hex 24`) al copiar a `.env`.

# Superusuario de PostgreSQL: lo usan la imagen y el init; los servicios no lo usan.
POSTGRES_PASSWORD=

# PostgreSQL: un runtime (<servicio>_app) y un migrador (<servicio>_migrator) por base.
# <SERVICIO> = IDENTITY, HOTEL, RECEPTION, INVENTORY, SALES, REPORTING, NOTIFICATION.
POSTGRES_IDENTITY_APP_PASSWORD=
POSTGRES_IDENTITY_MIGRATOR_PASSWORD=
POSTGRES_HOTEL_APP_PASSWORD=
POSTGRES_HOTEL_MIGRATOR_PASSWORD=
POSTGRES_RECEPTION_APP_PASSWORD=
POSTGRES_RECEPTION_MIGRATOR_PASSWORD=
POSTGRES_INVENTORY_APP_PASSWORD=
POSTGRES_INVENTORY_MIGRATOR_PASSWORD=
POSTGRES_SALES_APP_PASSWORD=
POSTGRES_SALES_MIGRATOR_PASSWORD=
POSTGRES_REPORTING_APP_PASSWORD=
POSTGRES_REPORTING_MIGRATOR_PASSWORD=
POSTGRES_NOTIFICATION_APP_PASSWORD=
POSTGRES_NOTIFICATION_MIGRATOR_PASSWORD=

# RabbitMQ: usuario de administracion y un usuario por servicio con Rabbit.
# `<servicio>` = IDENTITY, HOTEL, RECEPTION, INVENTORY, SALES, NOTIFICATION
# (reporting no usa Rabbit). El vhost del proyecto es `/hotel-demo`.
RABBITMQ_ADMIN_USER=hotel-admin
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_IDENTITY_PASSWORD=
RABBITMQ_HOTEL_PASSWORD=
RABBITMQ_RECEPTION_PASSWORD=
RABBITMQ_INVENTORY_PASSWORD=
RABBITMQ_SALES_PASSWORD=
RABBITMQ_NOTIFICATION_PASSWORD=
