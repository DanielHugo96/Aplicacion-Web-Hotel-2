{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/hotel.sede.v1.SedeSnapshot.schema.json",
  "title": "hotel.sede.v1 — SedeSnapshot",
  "description": "Snapshot de sede emitido por hotel (topic hotel.sede.v1, key=idHotel). Lo consume reporting. Una baja mantiene el snapshot completo con estado=false.",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "SedeSnapshot"
        },
        "aggregateType": {
          "const": "sede"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "idHotel serializado como texto (Kafka key)."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idHotel",
            "nombre",
            "ciudad",
            "estado",
            "publicado",
            "version"
          ],
          "properties": {
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador de la sede."
            },
            "nombre": {
              "type": "string",
              "description": "Nombre comercial de la sede."
            },
            "ciudad": {
              "type": "string",
              "description": "Ciudad de la sede."
            },
            "imagenUrl": {
              "type": ["string", "null"],
              "maxLength": 500,
              "description": "Foto principal de la sede; https de la lista permitida o /assets/. Nula si la sede no tiene imagen."
            },
            "imagenAlt": {
              "type": ["string", "null"],
              "maxLength": 150,
              "description": "Texto alternativo de imagenUrl; no nulo cuando hay imagen."
            },
            "estado": {
              "type": "boolean",
              "description": "false en una baja; el snapshot de baja conserva el resto de campos."
            },
            "publicado": {
              "type": "boolean",
              "description": "true si la sede se muestra en la landing pública."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión de la sede."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "SedeSnapshot",
      "schemaVersion": 1,
      "aggregateType": "sede",
      "aggregateId": "1",
      "aggregateVersion": 1,
      "idHotel": 1,
      "occurredAt": "2026-10-04T15:00:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idHotel": 1,
        "nombre": "Casa Sillar Lima Centro",
        "ciudad": "Lima",
        "imagenUrl": "/assets/sedes/lima-centro-fachada.jpg",
        "imagenAlt": "Fachada de piedra de la sede de Lima Centro al atardecer",
        "estado": true,
        "publicado": true,
        "version": 1
      }
    }
  ]
}
