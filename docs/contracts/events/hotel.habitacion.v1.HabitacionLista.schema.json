{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/hotel.habitacion.v1.HabitacionLista.schema.json",
  "title": "hotel.habitacion.v1 — HabitacionLista",
  "description": "Evento emitido por hotel cuando una limpieza se completa y la habitación queda LISTA (topic hotel.habitacion.v1, key=idHabitacion). Exige cleaningCycleId y cleaningRoomVersion (roomVersion de la tarea de limpieza, no hotel.version); reception solo libera el gate si estaba LIMPIEZA_PENDIENTE y coincide el ciclo, y nunca acepta un LISTA genérico como permiso de limpieza.",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "HabitacionLista"
        },
        "aggregateType": {
          "const": "habitacion"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "idHabitacion serializado como texto (Kafka key)."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Versión de la habitación al emitir el evento."
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idHabitacion",
            "idHotel",
            "numero",
            "idCategoria",
            "categoriaNombre",
            "pisoNombre",
            "precio",
            "estado",
            "estadoFisico",
            "version",
            "cleaningCycleId",
            "cleaningRoomVersion",
            "blockId"
          ],
          "properties": {
            "idHabitacion": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador de la habitación."
            },
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Sede de la habitación."
            },
            "numero": {
              "type": "string",
              "description": "Número visible de la habitación."
            },
            "idCategoria": {
              "type": "integer",
              "minimum": 1,
              "description": "Categoría de la habitación."
            },
            "categoriaNombre": {
              "type": "string",
              "description": "Nombre de la categoría al emitir el evento."
            },
            "pisoNombre": {
              "type": "string",
              "description": "Nombre del piso al emitir el evento."
            },
            "precio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "multipleOf": 0.01,
              "description": "Precio por noche de la habitación."
            },
            "estado": {
              "type": "boolean",
              "description": "Estado activo de la habitación."
            },
            "estadoFisico": {
              "type": "string",
              "enum": [
                "LISTA",
                "EN_LIMPIEZA",
                "MANTENIMIENTO"
              ],
              "description": "Código físico fijo; en este evento la habitación queda LISTA."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión de la habitación (no es cleaningRoomVersion)."
            },
            "cleaningCycleId": {
              "type": "string",
              "format": "uuid",
              "description": "Ciclo de limpieza completado; obligatorio en este evento."
            },
            "cleaningRoomVersion": {
              "type": "integer",
              "minimum": 0,
              "description": "roomVersion de la tarea de limpieza completada; obligatorio y distinto de hotel.version."
            },
            "blockId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "description": "Bloqueo vigente si lo hubiera; null cuando la habitación queda libre."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "HabitacionLista",
      "schemaVersion": 1,
      "aggregateType": "habitacion",
      "aggregateId": "101",
      "aggregateVersion": 4,
      "idHotel": 1,
      "occurredAt": "2026-10-05T17:00:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idHabitacion": 101,
        "idHotel": 1,
        "numero": "101",
        "idCategoria": 1,
        "categoriaNombre": "Individual",
        "pisoNombre": "Primer piso",
        "precio": 75.00,
        "estado": true,
        "estadoFisico": "LISTA",
        "version": 4,
        "cleaningCycleId": "44444444-4444-4444-8444-444444444444",
        "cleaningRoomVersion": 3,
        "blockId": null
      }
    }
  ]
}
