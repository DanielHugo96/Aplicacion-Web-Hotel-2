{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/inventory.movimiento.v1.MovimientoStockResuelto.schema.json",
  "title": "inventory.movimiento.v1 — MovimientoStockResuelto",
  "description": "Resolución del movimiento de stock de una venta emitida por inventory (topic inventory.movimiento.v1, key=idVenta, version del movimiento). Lo consume sales para compensaciones: solo finaliza una CANCELACION_PENDIENTE al ver RESTITUIDO, y un DESCONTADO tardío jamás confirma una venta por sí solo.",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "MovimientoStockResuelto"
        },
        "aggregateType": {
          "const": "movimiento-stock"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "idVenta serializado como texto (Kafka key)."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Versión del movimiento de stock."
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idVenta",
            "idHotel",
            "estado",
            "version"
          ],
          "properties": {
            "idVenta": {
              "type": "integer",
              "minimum": 1,
              "description": "Venta a la que pertenece el movimiento."
            },
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Sede del movimiento; debe coincidir con el movimiento existente o va a DLQ/alerta."
            },
            "estado": {
              "type": "string",
              "enum": [
                "DESCONTADO",
                "RECHAZADO",
                "RESTITUIDO"
              ],
              "description": "Resolución del movimiento de stock."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión del movimiento."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "MovimientoStockResuelto",
      "schemaVersion": 1,
      "aggregateType": "movimiento-stock",
      "aggregateId": "5001",
      "aggregateVersion": 1,
      "idHotel": 1,
      "occurredAt": "2026-10-04T15:05:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idVenta": 5001,
        "idHotel": 1,
        "estado": "DESCONTADO",
        "version": 1
      }
    }
  ]
}
