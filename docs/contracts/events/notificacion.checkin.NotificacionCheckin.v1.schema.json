{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/notificacion.checkin.NotificacionCheckin.v1.schema.json",
  "title": "notificacion.checkin — NotificacionCheckin",
  "description": "Comando RabbitMQ emitido por reception hacia notification (routing key y cola notificacion.checkin; exchange hotel.commands.v1) tras confirmar un check-in; genera la plantilla CHECKIN. El correo es efecto secundario: su caída no revierte el check-in. idHotel del envelope obligatorio.",
  "allOf": [
    {
      "$ref": "./command-envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "NotificacionCheckin"
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idPersona",
            "idRecepcion",
            "destinatario",
            "nombre",
            "hotel",
            "fechaSalida",
            "templateVersion"
          ],
          "properties": {
            "idPersona": {
              "type": "integer",
              "minimum": 1,
              "description": "Cliente de la estadía."
            },
            "idRecepcion": {
              "type": "integer",
              "minimum": 1,
              "description": "Estadía registrada."
            },
            "destinatario": {
              "type": "string",
              "format": "email",
              "description": "Correo destino; solo viaja por las colas privadas de notification."
            },
            "nombre": {
              "type": "string",
              "description": "Nombre con el que se personaliza la plantilla CHECKIN."
            },
            "hotel": {
              "type": "string",
              "description": "Nombre de la sede para el correo."
            },
            "fechaSalida": {
              "type": "string",
              "format": "date",
              "description": "Fecha de salida prevista (America/Lima)."
            },
            "templateVersion": {
              "const": 1,
              "description": "Versión de la plantilla CHECKIN; no se aceptan plantillas desconocidas."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "commandId": "33333333-3333-4333-8333-333333333333",
      "type": "NotificacionCheckin",
      "schemaVersion": 1,
      "idHotel": 1,
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "issuedAt": "2026-10-04T15:00:00Z",
      "payload": {
        "idPersona": 100,
        "idRecepcion": 1001,
        "destinatario": "cliente.uno@hotel.test",
        "nombre": "Cliente Uno",
        "hotel": "Hotel Demo Lima Centro",
        "fechaSalida": "2026-10-05",
        "templateVersion": 1
      }
    }
  ]
}
