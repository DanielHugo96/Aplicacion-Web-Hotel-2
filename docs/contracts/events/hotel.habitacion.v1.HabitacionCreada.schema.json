{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/hotel.habitacion.v1.HabitacionCreada.schema.json",
  "title": "hotel.habitacion.v1 — HabitacionCreada",
  "description": "Evento de alta de habitación emitido por hotel (topic hotel.habitacion.v1, key=idHabitacion). reception lo consume para crear el gate inicial (solo si la habitación es LISTA/activa) y reporting para su proyección. cleaningCycleId, cleaningRoomVersion y blockId viajan en null porque aún no hay ciclo de limpieza ni bloqueo.",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "HabitacionCreada"
        },
        "aggregateType": {
          "const": "habitacion"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "idHabitacion serializado como texto (Kafka key)."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Versión de la habitación al emitir el evento."
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idHabitacion",
            "idHotel",
            "numero",
            "idCategoria",
            "categoriaNombre",
            "pisoNombre",
            "precio",
            "estado",
            "estadoFisico",
            "version",
            "cleaningCycleId",
            "cleaningRoomVersion",
            "blockId"
          ],
          "properties": {
            "idHabitacion": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador de la habitación."
            },
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Sede de la habitación."
            },
            "numero": {
              "type": "string",
              "description": "Número visible de la habitación."
            },
            "idCategoria": {
              "type": "integer",
              "minimum": 1,
              "description": "Categoría de la habitación."
            },
            "categoriaNombre": {
              "type": "string",
              "description": "Nombre de la categoría al emitir el evento."
            },
            "pisoNombre": {
              "type": "string",
              "description": "Nombre del piso al emitir el evento."
            },
            "precio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "multipleOf": 0.01,
              "description": "Precio por noche de la habitación."
            },
            "estado": {
              "type": "boolean",
              "description": "Estado activo de la habitación; false en una baja."
            },
            "estadoFisico": {
              "type": "string",
              "enum": [
                "LISTA",
                "EN_LIMPIEZA",
                "MANTENIMIENTO"
              ],
              "description": "Código físico fijo de la habitación."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión de la habitación (no es roomVersion del gate)."
            },
            "cleaningCycleId": {
              "type": "null",
              "description": "null en el alta: todavía no existe ciclo de limpieza."
            },
            "cleaningRoomVersion": {
              "type": "null",
              "description": "null en el alta: todavía no existe roomVersion de limpieza."
            },
            "blockId": {
              "type": "null",
              "description": "null en el alta: la habitación no nace bloqueada."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "HabitacionCreada",
      "schemaVersion": 1,
      "aggregateType": "habitacion",
      "aggregateId": "101",
      "aggregateVersion": 1,
      "idHotel": 1,
      "occurredAt": "2026-10-04T15:00:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idHabitacion": 101,
        "idHotel": 1,
        "numero": "101",
        "idCategoria": 1,
        "categoriaNombre": "Individual",
        "pisoNombre": "Primer piso",
        "precio": 70.00,
        "estado": true,
        "estadoFisico": "LISTA",
        "version": 1,
        "cleaningCycleId": null,
        "cleaningRoomVersion": null,
        "blockId": null
      }
    }
  ]
}
