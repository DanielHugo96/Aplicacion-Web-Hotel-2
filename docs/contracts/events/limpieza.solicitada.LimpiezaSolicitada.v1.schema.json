{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/limpieza.solicitada.LimpiezaSolicitada.v1.schema.json",
  "title": "limpieza.solicitada — LimpiezaSolicitada",
  "description": "Comando RabbitMQ emitido por reception hacia hotel (routing key y cola limpieza.solicitada; exchange hotel.commands.v1) al cerrar una estadía. hotel valida la tupla y solo libera el gate con el cleaningCycleId y roomVersion correctos; duplicados y ciclos viejos no reabren ciclos completados.",
  "allOf": [
    {
      "$ref": "./command-envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "LimpiezaSolicitada"
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idHabitacion",
            "idRecepcion",
            "cleaningCycleId",
            "roomVersion"
          ],
          "properties": {
            "idHabitacion": {
              "type": "integer",
              "minimum": 1,
              "description": "Habitación a limpiar."
            },
            "idRecepcion": {
              "type": "integer",
              "minimum": 1,
              "description": "Estadía cerrada que originó el ciclo."
            },
            "cleaningCycleId": {
              "type": "string",
              "format": "uuid",
              "description": "Ciclo de limpieza creado por el cierre; identifica la tarea en hotel."
            },
            "roomVersion": {
              "type": "integer",
              "minimum": 0,
              "description": "roomVersion del gate al crear el ciclo; evita liberar con un ciclo viejo."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "commandId": "33333333-3333-4333-8333-333333333333",
      "type": "LimpiezaSolicitada",
      "schemaVersion": 1,
      "idHotel": 1,
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "issuedAt": "2026-10-05T16:00:00Z",
      "payload": {
        "idHabitacion": 101,
        "idRecepcion": 1001,
        "cleaningCycleId": "44444444-4444-4444-8444-444444444444",
        "roomVersion": 2
      }
    }
  ]
}
