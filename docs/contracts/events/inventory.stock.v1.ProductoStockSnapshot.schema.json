{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/inventory.stock.v1.ProductoStockSnapshot.schema.json",
  "title": "inventory.stock.v1 — ProductoStockSnapshot",
  "description": "Snapshot de stock por producto y sede emitido por inventory (topic inventory.stock.v1, key compuesta idHotel:idProducto, aggregateVersion=producto_sede.version). Lo consume reporting. estado es el estado efectivo (producto.estado AND producto_sede.estado), no una proyección del estado del hotel.",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "ProductoStockSnapshot"
        },
        "aggregateType": {
          "const": "producto-sede"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$",
          "description": "Clave compuesta idHotel:idProducto (Kafka key), p. ej. 1:1."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Versión de producto_sede."
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idProducto",
            "idHotel",
            "sku",
            "nombreProducto",
            "precio",
            "cantidad",
            "umbralBajo",
            "estado",
            "version"
          ],
          "properties": {
            "idProducto": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador global del producto."
            },
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Sede a la que pertenece el stock."
            },
            "sku": {
              "type": "string",
              "description": "SKU del producto."
            },
            "nombreProducto": {
              "type": "string",
              "description": "Nombre del producto."
            },
            "precio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "multipleOf": 0.01,
              "description": "Precio del producto en la sede."
            },
            "cantidad": {
              "type": "integer",
              "minimum": 0,
              "description": "Unidades disponibles en la sede."
            },
            "umbralBajo": {
              "type": "integer",
              "minimum": 0,
              "description": "Umbral de stock bajo configurado para la sede."
            },
            "estado": {
              "type": "boolean",
              "description": "Estado efectivo (producto AND producto_sede); false si está dado de baja en la sede."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión de producto_sede."
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "ProductoStockSnapshot",
      "schemaVersion": 1,
      "aggregateType": "producto-sede",
      "aggregateId": "1:1",
      "aggregateVersion": 1,
      "idHotel": 1,
      "occurredAt": "2026-10-04T15:05:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idProducto": 1,
        "idHotel": 1,
        "sku": "AGUA-500",
        "nombreProducto": "Agua500ml",
        "precio": 3.50,
        "cantidad": 48,
        "umbralBajo": 10,
        "estado": true,
        "version": 1
      }
    }
  ]
}
