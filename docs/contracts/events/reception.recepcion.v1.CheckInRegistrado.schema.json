{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/reception.recepcion.v1.CheckInRegistrado.schema.json",
  "title": "reception.recepcion.v1 — CheckInRegistrado",
  "description": "Evento de check-in emitido por reception (topic reception.recepcion.v1, key=idHabitacion, aggregateVersion=roomVersion). Payload = snapshot completo de la estadía; en este evento cierre=null porque no hay cierre y observacion=null porque Kafka no lleva observaciones personales. Lo consumen reporting y hotel (proyección de ocupación) y sales (no admite una venta sobre un check-in inexistente).",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "CheckInRegistrado"
        },
        "aggregateType": {
          "const": "habitacion-ocupacion"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "idHabitacion serializado como texto (Kafka key)."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "roomVersion del room_gate al confirmarse el check-in."
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idRecepcion",
            "idHotel",
            "idHabitacion",
            "idCliente",
            "numero",
            "nombreCliente",
            "fechaEntrada",
            "fechaSalida",
            "fechaSalidaConfirmacion",
            "estadoEstadia",
            "tarifa",
            "precioInicial",
            "adelanto",
            "medioPagoAdelanto",
            "costoPenalidad",
            "motivoPenalidad",
            "totalPagado",
            "observacion",
            "archivada",
            "version",
            "roomVersion",
            "closureId",
            "cleaningCycleId",
            "cierre",
            "ocupacionActual"
          ],
          "properties": {
            "idRecepcion": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador de la estadía."
            },
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Sede de la estadía."
            },
            "idHabitacion": {
              "type": "integer",
              "minimum": 1,
              "description": "Habitación de la estadía."
            },
            "idCliente": {
              "type": "integer",
              "minimum": 1,
              "description": "Cliente de la estadía."
            },
            "numero": {
              "type": "string",
              "description": "Número visible de la habitación al emitir el evento."
            },
            "nombreCliente": {
              "type": "string",
              "description": "Nombre del cliente; dato personal de uso interno."
            },
            "fechaEntrada": {
              "type": "string",
              "format": "date",
              "description": "Fecha de entrada (America/Lima, política de check-in desde las 15:00)."
            },
            "fechaSalida": {
              "type": "string",
              "format": "date",
              "description": "Fecha de salida prevista (America/Lima, check-out hasta las 12:00)."
            },
            "fechaSalidaConfirmacion": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "Sello UTC de cierre confirmado; null mientras la estadía no se cerró."
            },
            "estadoEstadia": {
              "type": "string",
              "enum": [
                "ACTIVA",
                "CERRANDO",
                "CERRADA"
              ],
              "description": "Estado de la estadía tras el hecho."
            },
            "tarifa": {
              "type": "number",
              "exclusiveMinimum": 0,
              "multipleOf": 0.01,
              "description": "Tarifa congelada por noche."
            },
            "precioInicial": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01,
              "description": "Precio de alojamiento de la estadía."
            },
            "adelanto": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01,
              "description": "Adelanto cobrado en el check-in."
            },
            "medioPagoAdelanto": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "EFECTIVO",
                "TARJETA",
                "OTRO",
                null
              ],
              "description": "Medio de pago del adelanto; null = NO_REGISTRADO (histórico migrado)."
            },
            "costoPenalidad": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01,
              "description": "Penalidad aplicada; 0 en el check-in."
            },
            "motivoPenalidad": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300,
              "description": "Motivo obligatorio cuando costoPenalidad > 0; null sin penalidad."
            },
            "totalPagado": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01,
              "description": "Total histórico pagado del alojamiento (incluye adelanto y cobro final)."
            },
            "observacion": {
              "type": "null",
              "description": "null por contrato: no se publican observaciones personales en Kafka."
            },
            "archivada": {
              "type": "boolean",
              "description": "true si la estadía fue archivada."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión de la estadía en la base de reception."
            },
            "roomVersion": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión del room_gate; coincide con aggregateVersion."
            },
            "closureId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "description": "Cierre vigente de consumos, o null si no hay."
            },
            "cleaningCycleId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "description": "Ciclo de limpieza vigente en el gate, o null si no hay."
            },
            "cierre": {
              "type": "null",
              "description": "null: un check-in no tiene desglose de cierre."
            },
            "ocupacionActual": {
              "type": "object",
              "additionalProperties": false,
              "description": "Estado del room_gate al momento del evento; no necesariamente la estadía histórica del evento.",
              "required": [
                "idRecepcion",
                "estadoGate",
                "cleaningCycleId",
                "blockId"
              ],
              "properties": {
                "idRecepcion": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "description": "Estadía que ocupa el gate; null si el gate no está OCUPADA."
                },
                "estadoGate": {
                  "type": "string",
                  "enum": [
                    "LIBRE",
                    "OCUPADA",
                    "LIMPIEZA_PENDIENTE",
                    "BLOQUEADA"
                  ],
                  "description": "Estado del gate tras el hecho."
                },
                "cleaningCycleId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid",
                  "description": "Ciclo de limpieza del gate, o null."
                },
                "blockId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid",
                  "description": "Bloqueo del gate, o null."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "estadoGate": {
                        "const": "OCUPADA"
                      }
                    },
                    "required": [
                      "estadoGate"
                    ]
                  },
                  "then": {
                    "properties": {
                      "idRecepcion": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "estadoGate": {
                        "const": "LIMPIEZA_PENDIENTE"
                      }
                    },
                    "required": [
                      "estadoGate"
                    ]
                  },
                  "then": {
                    "properties": {
                      "cleaningCycleId": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "estadoGate": {
                        "const": "BLOQUEADA"
                      }
                    },
                    "required": [
                      "estadoGate"
                    ]
                  },
                  "then": {
                    "properties": {
                      "blockId": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "CheckInRegistrado",
      "schemaVersion": 1,
      "aggregateType": "habitacion-ocupacion",
      "aggregateId": "101",
      "aggregateVersion": 1,
      "idHotel": 1,
      "occurredAt": "2026-10-04T15:00:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idRecepcion": 1001,
        "idHotel": 1,
        "idHabitacion": 101,
        "idCliente": 100,
        "numero": "101",
        "nombreCliente": "Cliente Uno",
        "fechaEntrada": "2026-10-04",
        "fechaSalida": "2026-10-05",
        "fechaSalidaConfirmacion": null,
        "estadoEstadia": "ACTIVA",
        "tarifa": 70.00,
        "precioInicial": 70.00,
        "adelanto": 20.00,
        "medioPagoAdelanto": "EFECTIVO",
        "costoPenalidad": 0.00,
        "motivoPenalidad": null,
        "totalPagado": 20.00,
        "observacion": null,
        "archivada": false,
        "version": 1,
        "roomVersion": 1,
        "closureId": null,
        "cleaningCycleId": null,
        "cierre": null,
        "ocupacionActual": {
          "idRecepcion": 1001,
          "estadoGate": "OCUPADA",
          "cleaningCycleId": null,
          "blockId": null
        }
      }
    }
  ]
}
