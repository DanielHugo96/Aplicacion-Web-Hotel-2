{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/recepcion.operacion-finalizar.RecepcionOperacionFinalizar.v1.schema.json",
  "title": "recepcion.operacion-finalizar — RecepcionOperacionFinalizar",
  "description": "Comando RabbitMQ emitido por sales hacia reception (routing key y cola recepcion.operacion-finalizar; exchange hotel.commands.v1) tras persistir el estado terminal de una operación de consumo. Incluye tipo para poder crear la lápida completa incluso si el comando llega antes de admitir la operación. Combinaciones válidas: VENTA → CONFIRMADA/RECHAZADA/CANCELADA; PAGO → PAGO_REGISTRADO/RECHAZADA; ANULACION → CANCELADA/RECHAZADA. Una tupla de IDs o un idHotel contradictorio va a DLQ sin desbloquear otra venta.",
  "allOf": [
    {
      "$ref": "./command-envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "RecepcionOperacionFinalizar"
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operationId",
            "idRecepcion",
            "idVenta",
            "tipo",
            "resultado"
          ],
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid",
              "description": "Operación de consumo creada por sales en reception."
            },
            "idRecepcion": {
              "type": "integer",
              "minimum": 1,
              "description": "Estadía de la operación."
            },
            "idVenta": {
              "type": "integer",
              "minimum": 1,
              "description": "Venta de la operación; en PAGO_REGISTRADO se refiere al pago y no al alta de la venta."
            },
            "tipo": {
              "type": "string",
              "enum": [
                "VENTA",
                "PAGO",
                "ANULACION"
              ],
              "description": "Tipo de operación."
            },
            "resultado": {
              "type": "string",
              "enum": [
                "CONFIRMADA",
                "RECHAZADA",
                "CANCELADA",
                "PAGO_REGISTRADO"
              ],
              "description": "Resultado terminal de la operación; debe ser compatible con el tipo."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "tipo": {
                    "const": "VENTA"
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              "then": {
                "properties": {
                  "resultado": {
                    "enum": [
                      "CONFIRMADA",
                      "RECHAZADA",
                      "CANCELADA"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "tipo": {
                    "const": "PAGO"
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              "then": {
                "properties": {
                  "resultado": {
                    "enum": [
                      "PAGO_REGISTRADO",
                      "RECHAZADA"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "tipo": {
                    "const": "ANULACION"
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              "then": {
                "properties": {
                  "resultado": {
                    "enum": [
                      "CANCELADA",
                      "RECHAZADA"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "examples": [
    {
      "commandId": "33333333-3333-4333-8333-333333333333",
      "type": "RecepcionOperacionFinalizar",
      "schemaVersion": 1,
      "idHotel": 1,
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "issuedAt": "2026-10-04T15:06:00Z",
      "payload": {
        "operationId": "55555555-5555-4555-8555-555555555555",
        "idRecepcion": 1001,
        "idVenta": 5001,
        "tipo": "VENTA",
        "resultado": "CONFIRMADA"
      }
    }
  ]
}
