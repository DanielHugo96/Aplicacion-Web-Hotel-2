{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotel.test/contracts/events/sales.venta.v1.VentaSnapshot.schema.json",
  "title": "sales.venta.v1 — VentaSnapshot",
  "description": "Snapshot de venta emitido por sales (topic sales.venta.v1, key=idVenta, versión de venta); se emite también al pagar desde el cierre o al cancelar, y las bajas son snapshots de anulación, nunca DELETE físico. Lo consume reporting. medioPago es anulable hasta que la venta se paga y es obligatorio en cada cobro (null = NO_REGISTRADO en históricos migrados).",
  "allOf": [
    {
      "$ref": "./envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "VentaSnapshot"
        },
        "aggregateType": {
          "const": "venta"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "idVenta serializado como texto (Kafka key)."
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Versión de la venta."
        },
        "idHotel": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idVenta",
            "idRecepcion",
            "idCliente",
            "idHotel",
            "estado",
            "estadoOperacion",
            "total",
            "medioPago",
            "createdAt",
            "paidAt",
            "closureId",
            "version",
            "detalles"
          ],
          "properties": {
            "idVenta": {
              "type": "integer",
              "minimum": 1,
              "description": "Identificador de la venta."
            },
            "idRecepcion": {
              "type": "integer",
              "minimum": 1,
              "description": "Estadía de la que cuelga el consumo."
            },
            "idCliente": {
              "type": "integer",
              "minimum": 1,
              "description": "Cliente derivado de la estadía."
            },
            "idHotel": {
              "type": "integer",
              "minimum": 1,
              "description": "Sede de la venta."
            },
            "estado": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "PAGADO"
              ],
              "description": "Estado del pago de la venta."
            },
            "estadoOperacion": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "CONFIRMADA",
                "RECHAZADA",
                "CANCELACION_PENDIENTE",
                "CANCELADA"
              ],
              "description": "Estado de la operación de admisión/compensación."
            },
            "total": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01,
              "description": "Importe total de la venta."
            },
            "medioPago": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "EFECTIVO",
                "TARJETA",
                "OTRO",
                null
              ],
              "description": "Medio de pago del cobro; null hasta que la venta se paga (históricos NO_REGISTRADO)."
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Fecha y hora UTC de creación de la venta."
            },
            "paidAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "Fecha y hora UTC del pago; null si sigue pendiente."
            },
            "closureId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "description": "Cierre de consumos en el que se pagó, o null."
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "description": "Versión de la venta."
            },
            "detalles": {
              "type": "array",
              "description": "Líneas inmutables tras confirmar la venta.",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "idProducto",
                  "nombreProducto",
                  "cantidad",
                  "precioUnitario",
                  "subTotal"
                ],
                "properties": {
                  "idProducto": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Producto vendido."
                  },
                  "nombreProducto": {
                    "type": "string",
                    "description": "Nombre del producto al confirmar la venta."
                  },
                  "cantidad": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999,
                    "description": "Unidades vendidas."
                  },
                  "precioUnitario": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "multipleOf": 0.01,
                    "description": "Precio unitario autoritativo de inventory."
                  },
                  "subTotal": {
                    "type": "number",
                    "minimum": 0,
                    "multipleOf": 0.01,
                    "description": "cantidad * precioUnitario."
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "11111111-1111-4111-8111-111111111111",
      "type": "VentaSnapshot",
      "schemaVersion": 1,
      "aggregateType": "venta",
      "aggregateId": "5001",
      "aggregateVersion": 2,
      "idHotel": 1,
      "occurredAt": "2026-10-04T15:05:00Z",
      "correlationId": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "idVenta": 5001,
        "idRecepcion": 1001,
        "idCliente": 100,
        "idHotel": 1,
        "estado": "PENDIENTE",
        "estadoOperacion": "CONFIRMADA",
        "total": 7.00,
        "medioPago": null,
        "createdAt": "2026-10-04T15:05:00Z",
        "paidAt": null,
        "closureId": null,
        "version": 2,
        "detalles": [
          {
            "idProducto": 1,
            "nombreProducto": "Agua500ml",
            "cantidad": 2,
            "precioUnitario": 3.50,
            "subTotal": 7.00
          }
        ]
      }
    }
  ]
}
