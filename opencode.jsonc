{
  // Configuración de OpenCode para este repositorio.
  //
  // Aquí hay muy poco a propósito. Antes esto tenía casi cuarenta reglas y
  // bloqueaba el trabajo normal del equipo, porque `policies` son GLOBALES:
  // las cumple todo el que abra el repositorio, no solo la campaña. Amendiar la
  // norma o leer el `.env` desde una sesión normal quedaba bloqueado, y eso no
  // lo arregla ninguna cantidad de reglas bien escritas.
  //
  // La división que se aplica ahora es:
  //
  //   - Aquí (`policies`): lo que daña el repositorio sea quien lo haga.
  //     Solo git: no se empuja a `main`, no se reescribe historia, no se borran
  //     ramas. Es literalmente la lista de `docs/guia-git.md`, y aplica a
  //     personas y a agentes por igual.
  //
  //   - En `.opencode/agents/*.md` (`permissions`): lo que solo le importa a la
  //     campaña, como no tocar la especificación ni los documentos de la norma.
  //     Cada agente lleva sus propias reglas, así que una persona puede seguir
  //     enmendando la norma desde su sesión sin commenting nada de aquí.
  //
  // Las políticas sobrevivían a un "Allow always"; los permisos de un agente
  // seaskedit con "Allow always", pero solo por ese agente. Para la campaña eso
  // da igual: nadie va a pulsarlo.
  "$schema": "https://opencode.ai/config.json",

  "policies": [
    // Se puede empujar a cualquier rama menos a main.
    // Gana la ÚLTIMA regla que casa: el allow va primero y las denegaciones al
    // final, para que `git push -u origin back-x --force` acabe denegado.
    { "action": "tool.use", "resource": "shell:git push *", "effect": "allow" },

    // No reescribir historia, no borrar ramas. Mismo criterio que
    // docs/guia-git.md, que dice que no se hace nunca.
    { "action": "tool.use", "resource": "shell:git push *--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *--delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -d*", "effect": "deny" },

    // Nunca a main. Dos variantes porque en opencode v2.0.32 el emparejamiento
    // de comodines es más fino de lo que parece: `git push * main` NO casa con
    // `git push origin main`, y se comprobó. Con estas dos, los dos casos
    // quedan bloqueados (verificado con servidor privado).
    { "action": "tool.use", "resource": "shell:git push * main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * main:*", "effect": "deny" }
  ]
}